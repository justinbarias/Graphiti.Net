{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session-start.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet tool restore:*)",
      "Bash(dotnet stryker:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(scripts/check.sh:*)",
      "Bash(scripts/mutate.sh:*)",
      "Bash(scripts/setup-env.sh:*)",
      "Bash(scripts/fetch-upstream.sh:*)",
      "Bash(python3 scripts/check_docs.py:*)"
    ],
    "deny": [
      "Edit(.upstream/**)",
      "Write(.upstream/**)",
      "Edit(port/judge/README.md)",
      "Write(port/judge/README.md)",
      "Edit(port/judge/add_reply.py)",
      "Write(port/judge/add_reply.py)",
      "Edit(port/judge/cases/**)",
      "Write(port/judge/cases/**)",
      "Edit(port/judge/count.txt)",
      "Write(port/judge/count.txt)",
      "Edit(port/judge/embedder-vectors.json)",
      "Write(port/judge/embedder-vectors.json)",
      "Edit(port/judge/golden/**)",
      "Write(port/judge/golden/**)",
      "Edit(port/judge/host-python/**)",
      "Write(port/judge/host-python/**)",
      "Edit(port/judge/pending/**)",
      "Write(port/judge/pending/**)",
      "Edit(port/judge/replies/**)",
      "Write(port/judge/replies/**)",
      "Edit(port/judge/run.py)",
      "Write(port/judge/run.py)"
    ]
  }
}
