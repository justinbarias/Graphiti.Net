<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Quickstart</RootNamespace>
    <!-- The example is not a library, so it has no XML documentation file. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- These packages are dependencies of the example only. The two product packages do not reference them. -->
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <ProjectReference Include="../../../src/Graphiti.Net/Graphiti.Net.csproj" />
    <ProjectReference Include="../../../src/Graphiti.Net.Neo4j/Graphiti.Net.Neo4j.csproj" />
  </ItemGroup>
</Project>
