{
  "name": "Graphiti.Net",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.devcontainer.yml"],
  "service": "dev",
  "runServices": ["neo4j", "dev"],
  "workspaceFolder": "/workspaces/Graphiti.Net",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "postCreateCommand": "bash scripts/setup-env.sh --python",
  "remoteEnv": {
    "DOTNET_ROOT": "/home/vscode/.dotnet",
    "PATH": "/home/vscode/.dotnet:/home/vscode/.dotnet/tools:/home/vscode/.local/bin:${containerEnv:PATH}",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "NEO4J_URI": "bolt://localhost:7687",
    "NEO4J_USER": "neo4j",
    "NEO4J_PASSWORD": "password"
  },
  "forwardPorts": [7474, 7687],
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit", "editorconfig.editorconfig", "anthropic.claude-code"]
    }
  }
}
