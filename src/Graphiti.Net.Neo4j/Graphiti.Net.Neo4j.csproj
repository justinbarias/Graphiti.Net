<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Graphiti.Neo4j</RootNamespace>
    <PackageId>Graphiti.Net.Neo4j</PackageId>
    <!-- A Python int has no limit. An overflow of a long throws OverflowException and never wraps (port/RULES.md, R18). -->
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Neo4j.Driver" />
    <ProjectReference Include="../Graphiti.Net/Graphiti.Net.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only the lead changes this list (port/RULES.md, R3). -->
    <InternalsVisibleTo Include="Graphiti.Net.JudgeHost" />
    <InternalsVisibleTo Include="Port.Evaluation" />
    <InternalsVisibleTo Include="Graphiti.Net.E2E.Tests" />
  </ItemGroup>
</Project>
