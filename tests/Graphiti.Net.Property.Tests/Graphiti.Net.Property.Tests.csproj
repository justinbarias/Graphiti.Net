<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Graphiti.PyCompat.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CsCheck" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/Graphiti.Net.PyCompat/Graphiti.Net.PyCompat.csproj" />
    <!-- Each file is written by a generator in port/tools/ from real Python: generate_<area>_values.py. -->
    <Content Include="python-values*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
