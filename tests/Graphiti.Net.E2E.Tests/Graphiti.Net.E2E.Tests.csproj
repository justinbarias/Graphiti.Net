<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Graphiti.E2E.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Neo4j.Driver" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <!-- The real service container (Microsoft.Extensions.DependencyInjection) for the tests of AddGraphiti. It is a
         shared framework of the SDK, not a package: Directory.Packages.props holds no container package. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/Graphiti.Net/Graphiti.Net.csproj" />
    <ProjectReference Include="../../src/Graphiti.Net.Neo4j/Graphiti.Net.Neo4j.csproj" />
    <ProjectReference Include="../../src/Graphiti.Net.PyCompat/Graphiti.Net.PyCompat.csproj" />
    <!-- Values that the recorders in port/tools recorded from Python at the pinned commit (port/RULES.md, R23). -->
    <Content Include="values/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The loop guard of the evaluation tests (port/RULES.md, R25). -->
    <Compile Include="..\Port.Evaluation\LoopGuard.cs" Link="LoopGuard.cs" />
  </ItemGroup>
</Project>
