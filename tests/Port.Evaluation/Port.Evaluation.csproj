<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Graphiti.Port.Evaluation</RootNamespace>
    <AssemblyName>Port.Evaluation</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/Graphiti.Net/Graphiti.Net.csproj" />
    <ProjectReference Include="../../src/Graphiti.Net.PyCompat/Graphiti.Net.PyCompat.csproj" />
    <ProjectReference Include="../Graphiti.Net.JudgeHost/Graphiti.Net.JudgeHost.csproj" />
    <!-- Values that a script in port/tools/ recorded from Python at the pinned commit (port/RULES.md, R23). -->
    <Content Include="values/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
